# PostgreSQL pada mesin Ubuntu yang sama dengan FastAPI.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=bioverse_db
DATABASE_USER=bioverse_api
DATABASE_PASSWORD=GANTI_DENGAN_PASSWORD_DATABASE_API

# Alternatif jika ingin memakai satu baris URL (hapus tanda # jika dipakai):
# DATABASE_URL=postgresql://bioverse_api:PASSWORD@127.0.0.1:5432/bioverse_db

# Kunci rahasia untuk token login JWT
SECRET_KEY=rahasia_bioverse_super_aman

# Origin frontend GitHub Pages (isi dengan origin tanpa path /BioVerse/).
# Contoh: https://username.github.io
ALLOWED_ORIGINS=https://nadhiffaizurrahman270-glitch.github.io

# OAuth Google Login. WAJIB: backend menolak login Google jika kosong.
# Isi dengan Client ID yang sama dengan <meta name="google-signin-client_id">
# di web/index.html. Beberapa ID dipisah koma.
GOOGLE_CLIENT_ID=

# Opsional untuk fitur BioBot.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
