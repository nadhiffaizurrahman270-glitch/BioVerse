# Salin file ini jadi ".env" lalu isi nilainya. Jangan commit file ".env" asli.

# Opsional. Kalau kosong, endpoint /api/v1/ai/tutor tetap jalan tapi
# BioBot akan membalas pesan "belum terhubung ke Gemini AI".
# Buat key di https://aistudio.google.com/app/apikeys
GEMINI_API_KEY=

# Opsional. Nama model Gemini yang dipakai BioBot.
GEMINI_MODEL=gemini-2.5-flash

# Opsional. Tambahan origin frontend yang boleh akses API ini, dipisah
# koma. Origin GitHub Pages BioVerse dan localhost dev sudah diizinkan
# secara default di app/main.py, jadi variable ini hanya perlu diisi
# kalau ada domain tambahan (misalnya custom domain).
# Contoh: ALLOWED_ORIGINS=https://domainlain.com,https://domainlain2.com
ALLOWED_ORIGINS=
