# ============================================================
# BioVerse - variabel untuk aplikasi Flutter (flutter_dotenv)
# File ini TIDAK BOLEH kosong. flutter_dotenv melempar
# EmptyEnvFileError untuk file kosong, sehingga main() berhenti
# sebelum runApp() dan halaman web tampil putih.
# ============================================================

# Opsional. Hanya dibaca oleh lib/services/gemini_service.dart
# (layar GeminiChatScreen yang belum terhubung ke navigasi).
# Fitur AI Tutor di aplikasi memanggil backend, BUKAN key ini.
#
# JANGAN isi API key asli di sini untuk versi yang di-deploy:
# .env ikut dibundel ke build/web/assets/.env dan bisa diunduh
# siapa pun lewat GitHub Pages.
GEMINI_API_KEY=
